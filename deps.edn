{:paths ["src/clj" "src/cljc" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/tools.logging {:mvn/version "1.3.1"}
        org.slf4j/slf4j-simple {:mvn/version "2.0.20"}
        ring/ring-core {:mvn/version "1.15.6"}
        ring/ring-jetty-adapter {:mvn/version "1.15.6"}
        ring/ring-defaults {:mvn/version "0.7.1"}
        bk/ring-gzip {:mvn/version "0.3.0"}
        radicalzephyr/ring.middleware.logger {:mvn/version "0.6.0"}
        environ/environ {:mvn/version "1.2.0"}
        com.stuartsierra/component {:mvn/version "1.2.0"}
        compojure/compojure {:mvn/version "1.7.2"}
        hiccup/hiccup {:mvn/version "2.0.0"}
        cheshire/cheshire {:mvn/version "6.2.1"}}
 :aliases
 {:run {:main-opts ["-m" "kugelmass.application"]}
  :cljs {:extra-paths ["src/cljs"]
         :extra-deps {org.clojure/clojurescript {:mvn/version "1.12.145"}
                      com.cognitect/transit-clj {:mvn/version "1.2.372"}
                      reagent/reagent {:mvn/version "2.0.1"}
                      cljsjs/react {:mvn/version "18.3.1-1"}
                      cljsjs/react-dom {:mvn/version "18.3.1-1"}
                      clj-commons/secretary {:mvn/version "1.2.4"
                                              :exclusions [com.cemerick/clojurescript.test]}
                      org.clojure/data.xml {:mvn/version "0.2.0-alpha11"}
                      cljs-ajax/cljs-ajax {:mvn/version "0.8.4"}}}
  :dev {:extra-paths ["dev" "dev-target"]
        :extra-deps {com.bhauman/figwheel-main {:mvn/version "0.2.20"}}}
  :cider {:extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}
                        cider/cider-nrepl {:mvn/version "0.64.1"}
                        cider/piggieback {:mvn/version "0.8.0"}}
          :jvm-opts ["-Djdk.attach.allowAttachSelf=true"]
          :main-opts ["-m" "nrepl.cmdline" "--bind" "127.0.0.1" "--port" "7888"
                      "--middleware" "[cider.nrepl/cider-middleware,cider.piggieback/wrap-cljs-repl]"]}
  :serve {:main-opts ["-m" "kugelmass.dev"]}
  :test {:extra-paths ["test/clj" "test/cljc" "test/cljs"]
         :main-opts ["-m" "kugelmass.test-runner"]}
  :cljs-test {:extra-paths ["test/cljs" "test/cljc"]
              :main-opts ["-m" "figwheel.main" "-co" "test.cljs.edn"]}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}}}
